# User-built executables, diagnostic launchers, hashes and release metadata are local-only.
/user-builds/*/*.exe
/user-builds/*/*.sha256
/user-builds/*/release-metadata.json
/user-builds/*/*.building.exe
/user-builds/*/*.previous-*.exe
/user-builds/*/Start-Diagnostic.bat
/user-builds/*/*.smoke.json

# Release packages are staged locally; publish only through an intentional release workflow.
/release-inbox/*/*
!/release-inbox/*/.gitkeep
!/release-inbox/*/README.txt

# Local updater cache/state from manual testing.
/updater/.cache/
*.update.lock
