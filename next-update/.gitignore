# The private test build is created in the one shared release/ directory.
# Keep the normal app artifact trackable: it is uploaded to this exact path
# only after explicit all-user release approval.
# Do not add /release/ArenaBridge.exe to this ignore file.

# Local-only diagnosis/build outputs (never distribution artifacts).
/release/ArenaBridge-Diagnose.exe
/release/*.sha256
/release/release-metadata.json
/release/*.building.exe
/release/*.previous-*.exe
/release/*.smoke.json
/release/Start-Diagnostic.bat

# Local updater cache/state from manual testing.
/update-system/updater/.cache/
*.update.lock
