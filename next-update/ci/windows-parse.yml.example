name: Windows PowerShell parser
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  parse:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - name: Parse with Windows PowerShell 5.1
        shell: powershell
        run: |
          & ./parse-gate.ps1
          exit $LASTEXITCODE
      - name: Gate rejects malformed input
        shell: powershell
        run: |
          $bad = Join-Path $env:RUNNER_TEMP 'bad.ps1'
          Set-Content -LiteralPath $bad -Value 'function Broken {' -Encoding UTF8
          & powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./parse-gate.ps1 -Path $bad
          if ($LASTEXITCODE -ne 1) { throw 'Parser gate did not reject malformed input' }
          exit 0
